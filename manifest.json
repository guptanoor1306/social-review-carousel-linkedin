{
  "display_information": {
    "name": "Social Asset Review",
    "description": "Batch review Instagram and LinkedIn assets with ratings and feedback.",
    "background_color": "#4A154B"
  },
  "features": {
    "bot_user": {
      "display_name": "Social Review",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/social-review",
        "description": "Create batches, publish reviews, and view results",
        "usage_hint": "create | start | reviewers | close | results",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "chat:write.public",
        "users:read",
        "channels:read",
        "groups:read",
        "files:read",
        "files:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
